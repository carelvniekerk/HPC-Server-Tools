# Define user information
export USER_NAME="niekerk"
export SETUP_COMPLETE=True
export PYTHON_VERSION="3.12.3"
export CUDA_VERSION="11.7.1"

# HPC Server Tools path
export HPC_TOOLS_PATH="/gpfs/project/${USER_NAME}/.usr_tls/hpc_server_tools"

# Setup the Index URL and link mode for UV
export UV_DEFAULT_INDEX="http://pypi.repo.test.hhu.de/simple/"
export UV_LINK_MODE=copy

# Setup colors for the ls command
export LS_COLORS='di=1;34:ln=1;36:so=1;35:pi=1;33:ex=1;32:bd=1;33;44:cd=1;33;44:su=1;31:sg=1;31:tw=1;34;42:ow=1;34;42'

# Dracula theme for FZF
export FZF_DEFAULT_OPTS=$FZF_DEFAULT_OPTS'
    --color=fg:#f8f8f2,fg+:#f8f8f2,bg:-1,bg+:#44475a
    --color=hl:#bd93f9,hl+:#bd93f9,info:#ffb86c,marker:#ff79c6
    --color=prompt:#50fa7b,spinner:#ffb86c,pointer:#ff79c6,header:#6272a4
    --border="rounded" --border-label="" --preview-window="border-rounded" --padding=0
    --margin=1 --prompt=" " --marker="" --pointer="➜"
    --separator="─" --scrollbar="│" --layout="reverse" --info="right"'

# Setup Offline mode for Huggingface
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_EVALUATE_OFFLINE=1

# Note: These names are correct, one starts with HF_... and the other with HUGGINGFACE_...
# https://huggingface.co/docs/datasets/en/cache#cache-directory
export HF_DATASETS_CACHE="/gpfs/project/${USER_NAME}/models/huggingface/datasets/"
export HUGGINGFACE_HUB_CACHE="/gpfs/project/$USER_NAME/models/huggingface/hub/"

# Set Offline mode for Weights & Biases
# https://docs.wandb.ai/guides/technical-faq/setup#can-i-run-wandb-offline
export WANDB_MODE=offline

# Set location for tmux dir
export TMUX_TMPDIR="/gpfs/project/${USER_NAME}/.usr_tls/.tmux"

# Setup the history file
HISTFILE="${HOME}/.bash_history"
HISTSIZE=100000
SAVEHIST=100000

# Setup the path
export PATH=$PATH:$HOME/.local/bin:$HOME/bin
