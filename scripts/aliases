# Remove the legacy alias when this file is re-sourced in an existing shell.
unalias qi 2>/dev/null || true

qi-help() {
    cat <<'EOF'
Noctua2 interactive GPU allocations

Usage:
  qi                         Start the saved interactive allocation in qi.sh
  qi --help                  Show this help without submitting an allocation
  qi-gpu <1|2|4>             Request that many A100s on one production node
  qi-2-gpu                   Shortcut for qi-gpu 2
  qi-4-gpu                   Shortcut for qi-gpu 4
  qi-setup --help            Show advanced saved-command configuration options

qi-gpu defaults:
  partition=gpu, nodes=1, tasks=1, CPUs=2, memory=52G per GPU, walltime=8:00:00
  resulting memory: 1 GPU=52G, 2 GPUs=104G, 4 GPUs=208G

Run qs to inspect compact GPU placement before requesting an allocation.
For reconnectability, start qi or qi-gpu inside tmux on the login node.
EOF
}

qi() {
    if [[ $# -eq 0 ]]; then
        source "${HPC_TOOLS_PATH}/job_submission/qi.sh"
        return
    fi

    if [[ $# -eq 1 ]]; then
        case "$1" in
            -h|--help|help)
                qi-help
                return
                ;;
        esac
    fi

    echo "Error: unsupported qi arguments. Run 'qi --help' for available commands."
    return 2
}

# Start a single-node interactive A100 allocation with the requested GPU count.
# Noctua2 production GPU nodes have four A100s, so larger values cannot be
# satisfied on one node. Scale host RAM with the worker count: a four-GPU
# ZeRO-2 Qwen3-4B smoke exceeded the former fixed 52G request while each rank
# was still loading model weights, before vLLM or the CUDA-memory test began.
qi-gpu() {
    if [[ $# -eq 1 ]]; then
        case "$1" in
            -h|--help|help)
                qi-help
                return
                ;;
        esac
    fi

    if [[ $# -ne 1 ]]; then
        echo "Usage: qi-gpu <1|2|4>"
        return 2
    fi

    local num_gpus="$1"
    case "${num_gpus}" in
        1|2|4) ;;
        *)
            echo "Error: Noctua2 A100 nodes have 4 GPUs; choose 1, 2, or 4."
            return 2
            ;;
    esac

    local memory_gib=$((52 * num_gpus))
    echo "Requesting Noctua2 interactive allocation:"
    echo "  job=DevSession-${num_gpus}GPU partition=gpu nodes=1 tasks=1"
    echo "  GPUs=${num_gpus} x A100 CPUs=2 RAM=${memory_gib}G walltime=8:00:00"
    echo "  shell=bash --login (exit the shell to release the allocation)"
    srun --pty \
        --job-name="DevSession-${num_gpus}GPU" \
        --partition=gpu \
        --nodes=1 \
        --ntasks=1 \
        --cpus-per-task=2 \
        --mem="${memory_gib}G" \
        --gres="gpu:a100:${num_gpus}" \
        --time=8:00:00 \
        bash --login
}

alias qi-2-gpu="qi-gpu 2"
alias qi-4-gpu="qi-gpu 4"
