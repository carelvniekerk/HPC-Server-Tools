# Aliases for loading modules
alias load_python="module load Python/${PYTHON_VERSION}"
alias load_cuda="module load CUDA/${CUDA_VERSION}"
alias load_tmux="module load tmux/3.3a"
alias load_installation_utils="module load intel/xe2020.4 gcc/11.1.0 SentencePiece/0.1.94"
alias base_installers='load_python && load_cuda && load_installation_utils'
alias base='load_python && load_cuda && load_tmux'

# Aliases for user tools
alias activate_cur_venv="source ${CURRENT_VENV}"
alias activate="source /gpfs/project/${USER_NAME}/.usr_tls/tools/activate_venv.sh"
alias qi-setup="python3 /gpfs/project/${USER_NAME}/.usr_tls/tools/get_interactive.py"
alias qi="source /gpfs/project/${USER_NAME}/.usr_tls/tools/qi.sh"
alias qs="python3 /gpfs/project/${USER_NAME}/.usr_tls/tools/resource_check.py"
alias submit_job="python3 /gpfs/project/${USER_NAME}/.usr_tls/tools/submit_job.py"
alias cleanup_job_logs="python3 /gpfs/project/${USER_NAME}/.usr_tls/tools/cleanup_logs.py"
alias job_log="python3 /gpfs/project/${USER_NAME}/.usr_tls/tools/job_log.py"

# Some alias for convenience:
alias home="cd /gpfs/project/${USER_NAME}"
alias q='exit'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias l='ls -l -d .* -d * --color=auto'
alias l.='ls -d .* --color=auto'
alias ll='ls -l --color=auto'
alias ls='ls --color=auto'
alias src="source ~/.bash_profile"

# Python aliases
alias py="python3"

# Tmux aliases
alias dev-tmux="source /gpfs/project/$USER_NAME/.usr_tls/tools/tmux_dev_session.sh"
