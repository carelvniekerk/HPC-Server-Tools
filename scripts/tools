# New clear command
clear() (
    if [ "$#" -ne 0 ]; then
        command clear "$@"
        exit
    fi
    h="$(tput lines 2>/dev/null)"
    if [ "$?" -eq 0 ]; then
        until [ "$h" -le 1 ]; do
            printf '\n'
            h=$((h-1))
        done
    fi
    command clear -x
)

# List all aliases grouped by category
function als(){
    alias | python3 "/gpfs/project/${USER_NAME}/.usr_tls/tools/aliases_cheatsheet.py" "$@"
}

# Add node and gpu stats tools
if [ -f "/gpfs/project/${USER_NAME}/.usr_tls/tools/gstat.sh" ]; then
    source "/gpfs/project/${USER_NAME}/.usr_tls/tools/gstat.sh"
fi

# Add git aliases and tools
if [ -f "/gpfs/project/${USER_NAME}/.usr_tls/tools/git.sh" ]; then
    source "/gpfs/project/${USER_NAME}/.usr_tls/tools/git.sh"
fi

# Add usefull poetry aliases and tools
# Load poetry completions
source <(poetry completions bash)
if [ -f "/gpfs/project/${USER_NAME}/.usr_tls/tools/poetry.sh" ]; then
    source "/gpfs/project/${USER_NAME}/.usr_tls/tools/poetry.sh"
fi

# Add fzf reverse search
source <(fzf --bash)
# Bind Up arrow key to the fuzzy find history search function using a key sequence
bind '"\e[A": "\C-r"'

# Add ziptools to the path
if [ -f "/gpfs/project/${USER_NAME}/.usr_tls/tools/ziptools" ]; then
    export PATH="/gpfs/project/${USER_NAME}/.usr_tls/tools:$PATH"
fi
