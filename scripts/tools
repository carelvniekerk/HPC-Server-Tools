# New clear command
clear() (
    if [ "$#" -ne 0 ]; then
        command clear "$@"
        exit
    fi
    h="$(tput lines 2>/dev/null)"
    if [ "$?" -eq 0 ]; then
        until [ "$h" -le 1 ]; do
            printf '\n'
            h=$((h-1))
        done
    fi
    command clear -x
)

# List all aliases grouped by category
export HPC_TOOLS_PYTHON="/gpfs/project/${USER_NAME}/.usr_tls/.venv/bin/python"
function als(){
    alias | ${HPC_TOOLS_PYTHON} "${HPC_TOOLS_PATH}/terminal_plugins/aliases_cheatsheet.py" "$@"
}

# Add node and gpu stats tools
if [ -f "${HPC_TOOLS_PATH}/resource_stats/gstat.sh" ]; then
    source "${HPC_TOOLS_PATH}/resource_stats/gstat.sh"
fi

# Add git aliases and tools
if [ -f "${HPC_TOOLS_PATH}/terminal_plugins/git.sh" ]; then
    source "${HPC_TOOLS_PATH}/terminal_plugins/git.sh"
fi

# Add usefull poetry aliases and tools
# Load poetry and UV completions
source <(uv generate-shell-completion bash)
source <(poetry completions bash)
if [ -f "${HPC_TOOLS_PATH}/poetry/poetry.sh" ]; then
    source "${HPC_TOOLS_PATH}/poetry/poetry.sh"
fi

# Add fzf reverse search
source <(fzf --bash)
# Bind Up arrow key to the fuzzy find history search function using a key sequence
bind '"\e[A": "\C-r"'

# Add ziptools to the path
if [ -f "${HPC_TOOLS_PATH}/terminal_plugins/ziptools" ]; then
    export PATH="${HPC_TOOLS_PATH}/terminal_plugins:$PATH"
fi
